{
  "name": "MonitorStarlinkBrasil",
  "productName": "Monitor Starlink Brasil",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "daveyhert <daviehert@gmail.com>",
  "license": "MIT",
  "description": "Monitor Starlink no Brasil — fork brasileiro do Dishylink para acompanhar desempenho e saúde do seu kit.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "vite",
    "dev:electron": "node scripts/make-icon.mjs && ELECTRON=1 vite",
    "dev:electron:win": "cross-env ELECTRON=1 vite",
    "build": "tsc -b && vite build",
    "build:electron": "ELECTRON=1 vite build",
    "pack:mac": "rm -rf dist dist-electron release && tsc -b && ELECTRON=1 vite build && node scripts/make-icon.mjs && electron-builder --mac --publish never",
    "pack:win": "tsc -b && cross-env ELECTRON=1 vite build && electron-builder --win --publish never",
    "release:mac": "rm -rf dist dist-electron release && tsc -b && ELECTRON=1 vite build && node scripts/make-icon.mjs && electron-builder --mac --publish always",
    "release:win": "tsc -b && cross-env ELECTRON=1 vite build && electron-builder --win --publish always",
    "make:icon": "node scripts/make-icon.mjs",
    "dev:extension": "wxt",
    "build:extension": "wxt build",
    "build:extension:firefox": "wxt build -b firefox",
    "build:extension:edge": "wxt build -b edge",
    "zip:extension": "wxt zip",
    "zip:extension:firefox": "wxt zip -b firefox",
    "zip:extension:edge": "wxt zip -b edge",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "historian": "tsx collector/historian.mts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "seed:desktop": "node scripts/seed-desktop.mjs",
    "typecheck": "tsc -b",
    "typecheck:extension": "wxt prepare && tsc --noEmit -p extension/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@number-flow/react": "0.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "satellite.js": "7.1.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@wxt-dev/module-react": "1.2.2",
    "cross-env": "10.1.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}