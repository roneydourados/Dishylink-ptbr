---
import Icon from "./Icon.astro";
import { GITHUB, PIX_KEY } from "../constants";

// App support menu, trimmed to star + PIX. Built on <details> so it opens
// without JavaScript; the script below only adds dismissal and PIX copy.
---

<details class="sponsor-menu relative">
  <summary
    class="flex cursor-pointer list-none items-center gap-2 text-sm text-ink-2 transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
  >
    <Icon name="heart" class="size-4 flex-none text-[#ea4aaa]" />
    <span class="whitespace-nowrap max-sm:sr-only">Apoiar o projeto</span>
  </summary>

  <div
    class="absolute right-0 z-50 mt-2 w-75 overflow-hidden max-sm:fixed max-sm:inset-x-3 max-sm:top-14 max-sm:w-auto rounded-xl border border-rule/50 bg-[color-mix(in_srgb,var(--color-surface)_80%,transparent)] text-ink shadow-[0_12px_40px_rgb(0_0_0/0.28),inset_0_1px_0_rgb(255_255_255/0.08)] backdrop-blur-xl backdrop-saturate-150 dark:bg-[color-mix(in_srgb,#0e0e0e_80%,transparent)] dark:shadow-[0_12px_40px_rgb(0_0_0/0.45),inset_0_1px_0_rgb(255_255_255/0.08)]"
  >
    <div class="p-1.5">
      <a
        href={GITHUB}
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full items-center gap-2.5 rounded-[8px] px-2 py-2 text-left text-[13px] text-ink no-underline transition-colors hover:bg-rule/40"
      >
        <span class="size-[15px] flex-none text-(--accent)">
          <Icon name="star" class="size-full" />
        </span>
        Dar estrela no GitHub
      </a>
      <button
        type="button"
        data-pix-copy
        data-pix-key={PIX_KEY}
        class="flex w-full cursor-pointer items-center gap-2.5 rounded-[8px] border-0 bg-transparent px-2 py-2 text-left text-[13px] text-ink transition-colors hover:bg-rule/40"
      >
        <span class="size-[15px] flex-none text-[#32bcad]">
          <Icon name="heart" class="size-full" />
        </span>
        <span class="flex min-w-0 flex-col items-start gap-0.5">
          <span data-pix-label>Doar via PIX</span>
          <span class="truncate font-mono text-[11px] text-ink-2">{PIX_KEY}</span>
        </span>
      </button>
    </div>
  </div>
</details>

<script>
  // Click-away and Escape, the two things <details> does not do on its own.
  const menus = document.querySelectorAll<HTMLDetailsElement>(".sponsor-menu");

  document.addEventListener("click", (event) => {
    for (const menu of menus) {
      if (!menu.contains(event.target as Node)) menu.open = false;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const menu of menus) menu.open = false;
  });

  document.querySelectorAll<HTMLButtonElement>("[data-pix-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const key = button.dataset.pixKey;
      if (!key) return;
      await navigator.clipboard.writeText(key);
      const label = button.querySelector("[data-pix-label]");
      if (label) {
        label.textContent = "Chave PIX copiada";
        window.setTimeout(() => {
          label.textContent = "Doar via PIX";
        }, 1800);
      }
    });
  });
</script>
