{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-orbita-landing",
  // No Worker code — this is a static asset upload. Nothing here reads a secret,
  // and account_id is deliberately absent: pass CLOUDFLARE_ACCOUNT_ID as an env
  // var so no account identifier is committed to a public repo.
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Add custom_domain routes here when a Painel Órbita domain is ready.
  // Example:
  // "routes": [
  //   { "pattern": "painelorbita.com.br", "custom_domain": true },
  //   { "pattern": "www.painelorbita.com.br", "custom_domain": true },
  // ],
}
